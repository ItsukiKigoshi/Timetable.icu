{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "timetable-icu",
	"compatibility_date": "2026-05-06",
	"compatibility_flags": [
		"nodejs_compat",
		"no_handle_cross_request_promise_resolution"
	],
	"build": {
		"command": "bun run build"
	},
	"assets": {
		"directory": "./dist/client/"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
  "d1_databases": [
    {
      "binding": "timetable_icu_tokyo",
      "database_name": "timetable-icu-tokyo",
      "database_id": "a6d88a6f-b0de-47c5-a481-8864f556a514"
    }
  ],
	"vars": {
		"BETTER_AUTH_URL": "https://timetable.icu",
		"PUBLIC_BASE_URL": "https://timetable.icu"
	}
}
